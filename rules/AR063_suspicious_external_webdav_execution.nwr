name="suspicious external webdav execution" rule="extension = '7z','bat','dat','cmd','exe','js','lnk','ps1','rar','url','vbe','vbs','zip' && ((client begins 'Microsoft-WebDAV-MiniRedir/' && action = 'GET','PROPFIND' && direction = 'outbound','lateral') || (user.agent begins 'Microsoft-WebDAV-MiniRedir/' && action = 'GET' && direction = 'outbound'))" alert=boc order=1 type=application
