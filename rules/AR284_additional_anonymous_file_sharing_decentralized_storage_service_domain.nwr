name="additional anonymous file-sharing/decentralized-storage service domains" rule="direction = 'outbound' && (alias.host contains 'temp.sh','dropmefiles.com','s3.filebase.com' || domain contains 'temp.sh','dropmefiles.com','s3.filebase.com' || domain.dst contains 'temp.sh','dropmefiles.com','s3.filebase.com' || url contains 'temp.sh','dropmefiles.com','s3.filebase.com')" alert=boc order=1 type=application
