name="unauthenticated monitoring/observability dashboard exposure" rule="action = 'get' && (directory contains 'api/search?type=dash-db','api/dashboards/home','graph','classic/graph','service-discovery','app/kibana','haproxy-status','haproxy?stats','config.json','..%3b/monitoring','backend/admin/users?username=anonymous','overview.html','mem_tracker','api/v1/data?chart=system.cpu','sensorlist.htm','opennms' || directory ends 'monitoring','/munin/','/overview','/dashboard' || query contains 'api/v1/status/config')" alert=eoc order=1 type=application
