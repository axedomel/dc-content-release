name="cloudflared tunnels related dns requests" rule="alias.host ends '.v2.argotunnel.com','protocol-v2.argotunnel.com','trycloudflare.com','update.argotunnel.com' || domain ends '.v2.argotunnel.com','protocol-v2.argotunnel.com','trycloudflare.com','update.argotunnel.com' || domain.dst ends '.v2.argotunnel.com','protocol-v2.argotunnel.com','trycloudflare.com','update.argotunnel.com' || url ends '.v2.argotunnel.com','protocol-v2.argotunnel.com','trycloudflare.com','update.argotunnel.com'" alert=boc order=1 type=application
