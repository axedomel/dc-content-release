name="system/cloud credential dotfile exposure" rule="action = 'get' && (filename = '.htpasswd','.netrc','_netrc','.pgpass','.my.cnf','.s3cfg','.esmtprc','.msmtprc','.ftpconfig','.credentials','.dockercfg' || directory ends '.aws/credentials','.docker/config.json','.gem/credentials','.gem/credentials.yaml')" alert=eoc order=1 type=application
