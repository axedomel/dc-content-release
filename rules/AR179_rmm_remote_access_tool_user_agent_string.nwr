name="rmm / remote-access tool user-agent string" rule="direction = 'outbound' && ((client = 'AnyDesk','MeshCentral' || client begins 'AnyDesk/','AnyDesk ','RemotePC ','NetSupport Manager/','NetSupport Gateway/','LogMeIn/','Lomond/' || client ends ' DesktopCentral Agent' || client contains 'splashtop') || (user.agent = 'AnyDesk','MeshCentral' || user.agent begins 'AnyDesk/','AnyDesk ','RemotePC ','NetSupport Manager/','NetSupport Gateway/','LogMeIn/','Lomond/' || user.agent ends ' DesktopCentral Agent' || user.agent contains 'splashtop'))" alert=boc order=1 type=application
