name="additional credential/secret file disclosure" rule="action = 'get' && (directory contains 'storage/oauth-private.key','storage/oauth-public.key','storage/framework/sessions','storage/sessions','node_modules/mqtt/test/helpers','_vti_pvt/service.pwd','sites/default/settings.php','wp-content/wflogs/config.php','wp-content/wflogs/config-synced.php','wp-content/wflogs/rules.php','wp-content/debug.log','data/db.sqlite','.vs/slnx.sqlite','000~root~000/etc/passwd','wwtest/phpinfo.php','password-page/ovf/account-credentials-ovf' || filename = 'slnx.sqlite' || (directory contains 'api/get-users' && query contains 'pagesize='))" alert=eoc order=1 type=application
