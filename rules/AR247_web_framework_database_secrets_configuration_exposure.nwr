name="web framework database/secrets configuration exposure" rule="action = 'get' && (filename = 'secrets.yml','configuration.yml','user_secrets.yml','database.yml','parameters.yml','databases.yml','local.xml','settings.py','manage.py' || directory ends 'config/secrets.yml','config/database.yml','app/config/parameters.yml','app/etc/local.xml')" alert=eoc order=1 type=application
