name="wildcard-dns-to-ip service abuse (sslip.io / nip.io)" rule="(alias.host = 'nip.io','sslip.io' || alias.host ends '.nip.io','.sslip.io') || (domain = 'nip.io','sslip.io' || domain ends '.nip.io','.sslip.io') || (domain.dst = 'nip.io','sslip.io' || domain.dst ends '.nip.io','.sslip.io') || (url = 'nip.io','sslip.io' || url ends '.nip.io','.sslip.io')" alert=boc order=1 type=application
