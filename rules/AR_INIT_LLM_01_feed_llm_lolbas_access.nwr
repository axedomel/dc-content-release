name="llm lolbas access" rule="(threat.category = 'llm-provider','llm-enterprise','llm-coding') && (tcp.dstport = 443 || tcp.dstport = 80 || tcp.dstport = 8080 || tcp.dstport = 8443 || tcp.dstport = 3128) && (client contains 'PowerShell' || client contains 'WindowsPowerShell' || client contains 'certutil' || client contains 'bitsadmin' || client contains 'wscript' || client contains 'cscript' || client contains 'mshta' || client contains 'regsvr32' || client contains 'rundll32' || client contains 'pythonw' || client contains 'Go-http-client')" alert=ioc order=1 type=application
