name="oob webhook-capture service abuse for c2/exfiltration" rule="direction = 'outbound' && (alias.host contains '.webhook.site','.webhookapp.com','.requestcatcher.com' || domain contains '.webhook.site','.webhookapp.com','.requestcatcher.com' || domain.dst contains '.webhook.site','.webhookapp.com','.requestcatcher.com' || url contains '.webhook.site','.webhookapp.com','.requestcatcher.com')" alert=boc order=1 type=application
