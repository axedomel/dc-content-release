name="spring boot actuator sensitive endpoint exposure" rule="action = 'get' && (directory contains 'actuator/env','actuator/heapdump','actuator/jolokia','actuator/threaddump','actuator/logfile','actuator/httptrace','actuator/httpexchanges','actuator/configprops','actuator/beans','actuator/mappings','actuator/loggers','actuator/dump','actuator/trace' || directory ends '/env','/heapdump','/jolokia' && directory contains 'actuator')" alert=eoc order=1 type=application
