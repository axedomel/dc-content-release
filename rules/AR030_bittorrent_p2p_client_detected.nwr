name="bittorrent p2p client detected" rule="direction = 'outbound' && service = 80,443 && (client contains 'BitComet/','BitTornado/','Transmission/','Deluge','KTorrent/3','rtorrent/','uTorrent','BTSP/','Enhanced-CTorrent','FDM 3.','Opera BitTorrent','Bittorrent' || user.agent contains 'BitComet/','BitTornado/','Transmission/','Deluge','KTorrent/3','rtorrent/','uTorrent','BTSP/','Enhanced-CTorrent','FDM 3.','Opera BitTorrent','Bittorrent')" alert=boc order=1 type=application
