name="eviltokens phaas worker railway" rule="(alias.host contains '-s-account.workers.dev' || alias.host ends '.up.railway.app') || (domain contains '-s-account.workers.dev' || domain ends '.up.railway.app') || (domain.dst contains '-s-account.workers.dev' || domain.dst ends '.up.railway.app') || (url contains '-s-account.workers.dev' || url ends '.up.railway.app')" alert=boc order=1 type=application
