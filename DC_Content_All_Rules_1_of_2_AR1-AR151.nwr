name="potential exploitation of cve-2025-4427/4428 ivanti epmm pre-auth rce" rule="directory contains '/mifs/rs/api/v2/featureusage' && query contains 'format=' && (query contains '{7*7}','%7B7*7%7D','%7b7%2a7%7d' || (query contains 'java.lang.Runtime' && query contains '.getMethod' && query contains 'getRuntime' && query contains '.exec(') || (query contains 'java%2elang%2eRuntime' && query contains '%2egetMethod' && query contains '%2eexec%28') || query contains '%6a%61%76%61%2e%6c%61%6e%67%2e%52%75%6e%74%69%6d%65%65%28%29','%67%65%74%52%75%6e%74%69%6d%65','%2e%65%78%65%63%28')" alert=ioc order=1 type=application

name="potential cve-2022-21587 exploitation attempt" rule="action = 'POST' && directory contains '/OA_HTML/' && filename = 'BneViewerXMLService','BneUploaderService','BneDownloadService','BneOfflineLOVService' && query contains 'bne:uueupload=TRUE'" alert=ioc order=1 type=application

name="atlassian bitbucket command injection via archive api" rule="directory contains '/rest/api/latest/projects/' && query contains 'prefix=' && query contains '%00--exec'" alert=ioc order=1 type=application

name="cve-2022-31656 vmware workspace one access auth bypass" rule="directory contains '/SAAS/t/_/;/'" alert=ioc order=1 type=application

name="apache spark shell command injection - weblogs" rule="query contains 'doAs=`','doAs=%60'" alert=boc order=1 type=application

name="zimbra collaboration suite email server unauthenticated rce" rule="action = 'POST' && filename = 'mboximport' && query contains 'account-name' && query contains 'ow' && query contains 'no-switch' && query contains 'append'" alert=boc order=1 type=application

name="owassrf exploitation attempt using public poc - webserver" rule="action = 'POST' && directory contains '/owa/mastermailbox' && directory contains '/powershell'" alert=boc order=1 type=application

name="potential centos web panel exploitation attempt - cve-2022-44877" rule="action = 'POST' && directory contains '/login/' && filename = 'index.php' && query contains 'login=$(','base64','subprocess','socket','${IFS}','cHl0aG9u','B5dGhvb','weXRob2'" alert=boc order=1 type=application

name="potential cve-2022-46169 exploitation attempt" rule="action = 'GET' && filename = 'remote_agent.php' && query contains 'action=polldata' && query contains 'poller_id=' && query contains '`whoami','wget','base64 -d','cmd','powershell'" alert=boc order=1 type=application

name="cve-2020-0688 exploitation attempt" rule="directory contains '/ecp/' && filename = 'default.aspx' && query contains '__VIEWSTATEGENERATOR=' && query contains '__VIEWSTATE='" alert=boc order=1 type=application

name="terramaster tos cve-2020-28188" rule="action = 'GET' && directory contains '/include' && filename = 'makecvs.php' && query contains 'Event=' && query contains 'curl','wget','.py','.sh','chmod','_GET'" alert=boc order=1 type=application

name="cve-2020-5902 f5 big-ip exploitation attempt" rule="directory contains '/tmui/','/hsqldb' && directory contains '..;/','.jsp/..'" alert=boc order=1 type=application

name="oracle weblogic exploit cve-2020-14882" rule="directory contains '/console/images/%252E%252E%252F','/console/css/%2e' && filename = 'console.portal'" alert=ioc order=1 type=application

name="citrix ads exploitation cve-2020-8193 cve-2020-8195" rule="(filename = 'filedownload' && directory contains 'rapi' && query contains 'filter=path:%2f') || (filename = 'report' && directory contains 'pcidss' && query contains 'type=all_signatures' && query contains 'sig_name=_default_signature_')" alert=ioc order=1 type=application

name="cisco asa ftd exploit cve-2020-3452" rule="directory contains '+CSCOT+' && filename = 'translation-table','oem-customization' && query contains '&textdomain=/','&textdomain=%','&name=/','&name=%'" alert=ioc order=1 type=application

name="solarwinds supernova webshell access" rule="filename contains 'logoimagehandler.ashx' && query contains 'clazz'" alert=ioc order=1 type=application

name="potential cve-2023-46214 exploitation attempt" rule="action = 'POST' && query contains 'NO_BINARY_CHECK=1' && query contains 'input.path' && query ends '.xsl'" alert=ioc order=1 type=application

name="exploitation attempt of cve-2023-46214 using public poc code" rule="action = 'POST' && ((directory contains '/splunkd/__upload/indexing' && filename = 'preview' && query contains 'NO_BINARY_CHECK=1' && query contains 'input.path=shell.xsl') || (directory contains '/api/search/jobs' && filename = 'results' && query contains '/opt/splunk/var/run/splunk/dispatch/' && query contains '/shell.xsl'))" alert=ioc order=1 type=application

name="potential cve-2023-25717 exploitation attempt" rule="action = 'GET' && directory contains '/forms' && filename = 'doLogin' && query contains 'login_username' && query contains 'password' && query contains '$(','%24%28'" alert=ioc order=1 type=application

name="cve-2023-22518 exploitation attempt - vulnerable endpoint connection (webserver)" rule="action = 'POST' && filename contains 'setup-restore-local.action','setup-restore-progress.action','setup-restore.action','server-info.action','setupadministrator.action'" alert=boc order=1 type=application

name="potential information disclosure cve-2023-43261 exploitation - web" rule="action = 'GET' && directory contains '/lang/log' && filename contains 'httpd.log'" alert=eoc order=1 type=application

name="potential cve-2023-23752 exploitation attempt" rule="action = 'GET' && directory contains '/api/index.php/v1/' && query contains 'public=true'" alert=ioc order=1 type=application

name="potential cve-2023-25157 exploitation attempt" rule="action = 'GET' && directory contains '/geoserver' && filename = 'ows' && query contains 'CQL_FILTER=' && query contains 'PropertyIsLike','strEndsWith','strStartsWith','FeatureId','jsonArrayContains','DWithin' && query contains '+--','+AS+','+OR+','FROM','ORDER+BY','SELECT','sleep%28','substring%28','UNION','WHERE'" alert=ioc order=1 type=application

name="moveit cve-2023-34362 exploitation attempt - potential web shell request" rule="action = 'GET' && filename = 'human2.aspx','_human2.aspx'" alert=ioc order=1 type=application

name="cve-2024-1709 - screenconnect authentication bypass exploitation" rule="directory contains '/SetupWizard.aspx/'" alert=ioc order=1 type=application

name="cve-2024-1212 exploitation - progress kemp loadmaster unauthenticated command injection" rule="action = 'GET' && directory contains '/access/' && filename = 'set' && query contains 'param=enableapi' && query contains 'value=1'" alert=boc order=1 type=application

name="potential cve-2021-27905 exploitation attempt" rule="directory contains '/solr/' && ((directory contains '/debug/' && filename = 'dump' && query contains 'param=ContentStream') || (action = 'GET' && filename = 'replication' && query contains 'command=fetchindex' && query contains 'masterUrl='))" alert=boc order=1 type=application

name="cve-2021-21972 vsphere exploitation" rule="action = 'POST' && directory contains '/vropspluginui/rest/services/' && filename = 'uploadova'" alert=ioc order=1 type=application

name="exploitation of cve-2021-26814 in wazuh" rule="directory contains '/manager/' && filename = 'files' && query contains 'path=etc/lists/../../../../..'" alert=ioc order=1 type=application

name="cve-2021-21978 exploitation attempt" rule="action = 'POST' && filename = 'wsgi_log_upload.py' && query contains 'logupload' && query contains 'logMetaData'" alert=ioc order=1 type=application

name="oracle weblogic exploit cve-2021-2109" rule="action = 'GET' && query contains 'com.bea.console.handles.JndiBindingHandle' && query contains 'ldap://' && query contains 'AdminServer'" alert=ioc order=1 type=application

name="potential cve-2021-26084 exploitation attempt" rule="action='POST' && filename = 'createpage-entervariables.action' && query contains 'SpaceKey=x'" alert=ioc order=1 type=application

name="sonicwall ssl/vpn jarrewrite exploitation" rule="filename = 'jarrewrite.sh' && (client contains ':;','() {','/bin/bash -c' || user.agent contains ':;','() {','/bin/bash -c')" alert=ioc order=1 type=application

name="proxylogon reset virtual directories based on iis log" rule="action='POST' && directory contains 'DDIService.svc' && filename = 'SetObject' && query contains 'schema=Reset' && query contains 'VirtualDirectory'" alert=ioc order=1 type=application

name="arcadyan router exploitations" rule="directory contains '..%2f' && directory contains '/setup_top_login.htm','/login.html','/loginerror.html','/loginexclude.html','/loginlock.html'" alert=boc order=1 type=application

name="vmware vcenter server file upload cve-2021-22005" rule="action = 'POST' && directory contains '/analytics/telemetry/ph/api/hyper/send'" alert=boc order=1 type=application
